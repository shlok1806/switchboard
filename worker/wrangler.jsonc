{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "account_id": "39dcea2708185ee6ae46f7ac3e289ca5",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Dashboard at `/` (#17). `wrangler dev` and `wrangler deploy` run the build
  // first: it builds dashboard/ into ./site, or copies the stopgap page in ./public
  // there when the Dashboard cannot be built. Asset paths are served first;
  // everything else, including /api, reaches the Worker.
  "build": {
    "command": "npx tsx ../scripts/build-site.ts",
    "watch_dir": ["../dashboard/src", "../shared/src"]
  },
  "assets": { "directory": "./site" },
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "Channel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  "vars": {
    // The GitHub repo whose Issues are this Channel's Tasks (ADR 0001).
    "GITHUB_REPO": "shlok1806/switchboard",
    // An Agent goes Gone after this many seconds without a heartbeat.
    "PRESENCE_GONE_AFTER_SECONDS": "600",
    // The Relay downgrades an Interrupt Jev gives less than this probability to a Queue.
    "RELAY_INTERRUPT_THRESHOLD": "0.6",
    // At most one Interrupt per Agent this many seconds; extra Interrupts become Queue.
    "RELAY_INTERRUPT_INTERVAL_SECONDS": "20"
  },
  // Set with `wrangler secret put`. JOIN_SECRET is the shared join secret
  // (interim identity, issue #1). JEV_API_KEY calls Jev for the Relay's Verdicts
  // (ADR 0003); for `wrangler dev`, put it in the gitignored .dev.vars.
  // GITHUB_TOKEN reads and creates Issues in GITHUB_REPO. GITHUB_WEBHOOK_SECRET
  // verifies deliveries to /api/github/webhook.
  "secrets": { "required": ["JOIN_SECRET", "JEV_API_KEY", "GITHUB_TOKEN", "GITHUB_WEBHOOK_SECRET"] }
}
