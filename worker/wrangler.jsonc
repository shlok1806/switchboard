{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "account_id": "39dcea2708185ee6ae46f7ac3e289ca5",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Dashboard (#17), at `/<owner>/<repo>` for each Channel (ADR 0007).
  // `wrangler dev` and `wrangler deploy` run the build first: it builds dashboard/
  // into ./site, or copies the stopgap page in ./public there when the Dashboard
  // cannot be built. Asset paths are served first; everything else, including
  // /r/<owner>/<repo>/api and /auth, reaches the Worker.
  "build": {
    "command": "npx tsx ../scripts/build-site.ts",
    "watch_dir": ["../dashboard/src", "../shared/src"]
  },
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "Channel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  "vars": {
    // One Channel per GitHub repo (ADR 0007). While testing, only these repos
    // (comma-separated `owner/repo`) may have a Channel; empty allows any repo the
    // GitHub App is installed on.
    "ALLOWED_REPOS": "shlok1806/switchboard",
    // An Agent goes Gone after this many seconds without a heartbeat.
    "PRESENCE_GONE_AFTER_SECONDS": "600",
    // The Relay downgrades an Interrupt Jev gives less than this probability to a Queue.
    "RELAY_INTERRUPT_THRESHOLD": "0.6",
    // At most one Interrupt per Agent this many seconds; extra Interrupts become Queue.
    "RELAY_INTERRUPT_INTERVAL_SECONDS": "20"
  },
  // Set with `wrangler secret put` (docs/github-app-setup.md). JEV_API_KEY calls Jev
  // for the Relay's Verdicts (ADR 0003); GITHUB_WEBHOOK_SECRET verifies deliveries to
  // /api/github/webhook. The GitHub App's secrets (GITHUB_APP_ID,
  // GITHUB_APP_PRIVATE_KEY, GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET) and
  // SESSION_SECRET are left out of this list on purpose: without them the Worker
  // still deploys, and sign-in says "GitHub App not configured". For `wrangler dev`,
  // put them in the gitignored .dev.vars (docs/github-app-setup.md).
  "secrets": { "required": ["JEV_API_KEY", "GITHUB_WEBHOOK_SECRET"] }
}
